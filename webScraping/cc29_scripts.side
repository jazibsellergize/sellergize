      "target": " const elements_image = document.querySelectorAll(   'ul[class=\"slider animated\"] > li' ); const dataArr = []; elements_image.forEach((a) => {   let url = \"https://www.pvrcinemas.com/\";   let image = a.querySelector(\"img\");   if (!image) {     return;   }   image = image?.src;   let title = a.querySelector(\"img\");   title = title ? title.alt : \"\";   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let row = {     store: \"pvrcinemas.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"image\",     code: \"See Image\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
