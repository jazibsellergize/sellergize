      "comment": "",
      "command": "executeScript",
      "target": "const dataArr = []; const elements_text = document.querySelectorAll(   \"#shipping-policy-policy-modal p.p1\" ); elements_text.forEach((a) => {   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\")) {     url = \"https://www.dreametech.com/\" + url;   }   let title = a;   title = title ? title.innerText.split(\".\")[0] : \"\";   if (title == \"\") {     title = a.querySelector(\"img\");     title = title ? title.alt : \"\";   }   if (title == \"\") {     title = a.innerText;   }   let description =  \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if (!image.startsWith(\"http\") && image != \"\") {     image = \"https:\" + image;   }   if (!title && !image) {     return;   }   let crawl_type = \"\";   if (!title) {     crawl_type = \"image\";   } else {     crawl_type = \"text\";   }   let row = {     store: \"dreametech.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: crawl_type,     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
