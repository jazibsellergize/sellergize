      "target": "let existingData = localStorage.getItem(\"crawl_data\"); let bool = true; const dataArr = []; const elements_image = document.querySelector(   'div[class=\"mosaic-wrapper__top\"]' ); let url = elements_image.querySelector(\"a\"); url = url   ? url.href   : \"https://www.casino.fr/ecommerce/GC-catalog/fr/WE75710/?moderetrait=Z2\"; let image = elements_image.querySelector(\"img\"); image = image.src; let title = elements_image.querySelector(   \"div[class='mosaic-slide__header-title']\" ); title = title ? title.innerText : \"\"; let description = elements_image.querySelector(\"p\"); description = description ? description.innerText : \"\"; let row = {   store: \"casino.fr\",   url: url,   title: title,   description: description,   image_url: image,   crawl_type: \"image\",   code: \"See Image\",   expiry: \"\", }; dataArr.push(row); if (!existingData) {   existingData = []; } else {   if (existingData.includes(image)) {     existingData = JSON.parse(existingData);     bool = false;   } else {     existingData = JSON.parse(existingData);     existingData = [...existingData, ...dataArr];   } } localStorage.setItem(\"crawl_data\", JSON.stringify(existingData)); return bool;",
