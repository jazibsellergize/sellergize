      "comment": "",
      "command": "executeScript",
      "target": " const dataArr = []; const elements_image = document.querySelectorAll(   \".img-animate a\" ); elements_image.forEach((a) => {   let url = a;   url = a.href ? a.href: \"https://www.sheinindia.in/\";           let image = a.querySelector(\"img\");   if (!image) {     return;   }   image = image.src;    let title = a.querySelector(\"img\");   title = title?.alt;   let row = {     store: \"sheinindia.in\",     url: url,     title: title,     description: '',     image_url: image,     crawl_type: \"image\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); });  localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
