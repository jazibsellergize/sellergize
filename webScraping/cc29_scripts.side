      "target": "const elements = document.querySelectorAll(     'ul[class*=\"fx-items-center ma-list\"]>li, div[class*=\"pre-header\"], div[class*=\"main-slider \"] a, div[class*=\"reinsurance-wrapper\"] div[class*=\"items\"]' ); const dataArr = []; elements.forEach((a) => {     let url = a.href;     if (!url) {         url = a.querySelector(\"a\");         url = url ? url.href : \"\";     }     if (!url.startsWith(\"http\")) {         url = \"https://www.mister-auto.it\" + url;     }     let title = a.querySelector('span');     if(!title){         title = a.querySelector('a');     }     title = title ?  title.innerText : \"\";     if(title == ''){         title = a.querySelector('img');         title = title ?  title.alt : \"\";     }      if(title == ''){         title = a.innerText;     }       let description = a.querySelector('p');     description = description ? description.innerText : \"\";     let image = a.querySelector('img');     image = image ? image.src : \"\";     if(image.includes('data:image')){         image == '';     }      if (!title && !image) {         return;     }     if (!image.startsWith(\"http\") && image != \"\") {         image = \"https:\" + image;     }           let crawl_type = '';     if (!title) {         crawl_type = 'image';     } else {         crawl_type = 'text';     }     let row = {         store: \"mister-auto.it\",         url: url,         title: title,         description: description,         image_url: image,         crawl_type: crawl_type,         code: '',         expiry: '',     };     dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
