      "target": "const dataArr = []; const shadow = document.querySelector(\"klarna-placement\")?.shadowRoot; const elements_text = shadow.querySelectorAll( \"p\" );  elements_text.forEach((a) => {   let title = a;   title = title?.innerText;   if(!title) {     title = a.querySelector('img');     title = title ? title.alt : \"\";   }   let description = a;    description = description?.innerText;   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"https://www.canadagoose.com/ca/en/pr/stratus-jacket-tonal-label-2481MT.html\";   }   if (url && !url.startsWith(\"https\")) {     url = \"https://www.canadagoose.com\" + url;   }    let image = a.querySelector(\"source\");   image = image ? image.srcset : \"\";   if(!image) {     image = a.querySelector(\"img\");     image = image ? image.src : \"\";   }    if( image && !image.startsWith(\"https\")) {     image = \"https:\" + image;   }    if(!title && !image) {     return;   }      let row = {     store: \"canadagoose.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: title ? \"text\" : \"image\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); });    localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
