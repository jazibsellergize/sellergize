      "comment": "",
      "command": "executeScript",
      "target": "const dataArr = []; const elements_text = document.querySelectorAll(   \"div[data-qa='promo_banner_header'] ul>li, section[data-qa='site_promo_banner_wrapper'], div[data-qa='site_promo_2up-carousel_wrapper'], section[class='card-tiles'] div[class*='links-container '] a, div.slick-list>div>div\" ); for (let i = 0; i < elements_text.length && i < 20 ; i++) {   let a = elements_text[i];     let title = a.querySelector('div.promo-item>a');     if (!title){         title = a.querySelector('p[data-qa*=\"title\"]')     }  if (!title) {   title = a.querySelector('a'); }  if (!title) {   title = a.querySelector('h1, h2'); }  title = title ? title.innerText : \"\";  if (title == \"\") {   title = a.innerText; }   let description = a.querySelector(\"div[class*='recommended-price']\");   if (!description) {     description = a.querySelector(\"p\");   }   description = description ? description.innerText.trim() : \"\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.katespadeoutlet.com/\" + url;   }   let row = {     store: \"katespadeoutlet.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }; localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
      "value": "data"
    }, {
