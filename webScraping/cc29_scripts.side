      "target": "const elements_image = document.querySelectorAll(   \".announcement-bar--item-content, .slideshow__slide , .content-top-left  \" ); const dataArr = []; elements_image.forEach((a) => {   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://us.elegoo.com\" + url;   } else if (url == \"\") {     url = \"https://us.elegoo.com/\";   }   let title = a.querySelector(\"h2, h4\");    if(!title){     title = a;   }   title = title ? title.innerText : \"\";   let description = a.querySelector(\"p\");   if(!description){     description = a;   }   description = description?.innerText;   let image = a.querySelector(\"source\");   image = image ? image.srcset : \"\";   if(!image){     image = a.querySelector(\"img\");     image = image ? image.src : \"\";   }   if (!image.startsWith(\"http\") && image != \"\") {     image = \"https:\" + image;   }   let row = {     store: \"us.elegoo.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
