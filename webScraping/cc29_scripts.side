      "id": "e7f36f38-2eb1-4a91-8c6d-72cdbcbb592c",
      "comment": "",
      "command": "executeScript",
      "target": "const elements = document.querySelectorAll(   'div[class=\"offer-container\"]>div, div.c_full-hero > div' ); const dataArr = []; elements.forEach((a) => {   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.belk.com\" + url;   } else if (url == \"\") {     url = \"https://www.belk.com/coupons-online-and-in-store\";   }   let title = a.querySelector('div[class=\"coupon-container\"]');   title = title ? title.innerText : \"\";   if (title) {     title = title.replaceAll(/\\u000A/g, \" \");     title = title.trim();   }   if (title == \"\") {     title = a.querySelector(\"img\");     title = title ? title.alt : \"\";   }   if (title == \"\") {     title = a.innerText;   }   if (!title) {     return;   }   let description = a.querySelector('div[class=\"coupon-wrapper\"]');   description = description ? description.innerText : \"\";   if (description) {     description = description.replaceAll(/\\u000A/g, \" \");     description = description.trim();   }   description =     description +     \". For more details check https://www.belk.com/coupons-online-and-in-store\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if (!image.startsWith(\"http\") && image != \"\") {     image = \"https:\" + image;   }   if (!image) {     return;   }   let code = a.querySelector('div[class=\"coupon-use-code\"]');   code = code ? code.innerText : \"\";   let expiry = a.querySelector('div[class=\"coupon-ends\"]');   expiry = expiry ? expiry.innerText : \"\";   expiry = expiry.substr(expiry.indexOf(\".\") + 2);   expiry = expiry.substr(0, expiry.indexOf(\",\"));   if (expiry) {     expiry = expiry + \"/2024\";   }   let crawl_type = \"\";   if (!title) {     crawl_type = \"image\";   } else {     crawl_type = \"text\";   }   let row = {     store: \"belk.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: crawl_type,     code: code,     expiry: expiry,   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
