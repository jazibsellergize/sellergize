      "comment": "",
      "command": "//executeScript",
      "target": "const elements = document.querySelectorAll(     'div[class=\"promo-items-secondary\"]>a, div[id=\"swiper-1\"] div[class=\"swiper-wrapper\"]>div, section[id=\"swiper-2\"] div[class=\"swiper-wrapper\"]>div,  div[id=\"swiper-3\"] div[class=\"swiper-wrapper\"]>div' ); const dataArr = []; elements.forEach((a) => {     let url = a.href;     if (!url) {         url = a.querySelector(\"a\");         url = url ? url.href : \"\";     }     if (!url) {         url = a.href ? a.href : \"https://www.mightyape.co.nz/\";     }     let title = a.querySelector('h3');     if (!title) {         title = a.querySelector('div[class=\"title\"] a');     }     title = title ? title.innerText : \"\";     if (title == \"\") {         title = a.querySelector('img');         title = title ? title.alt : \"\";     }     let description = a.querySelector('div[class=\"ci-module-pretitle \"]');     description = description ? description.innerText : \"\";     let image = a.querySelector(\"img\");     image = image ? image.src : \"\";     if (image == \"\") {         image = a.querySelector('source');         image = image ? image.srcset : \"\";     }     if (!image.startsWith(\"http\") && image != \"\") {         image = \"https://www.mightyape.co.nz/\" + image;     }     if (!title && !image) {         return;     }     let row = {         store: \"mightyape.co.nz\",         url: url,         title: title,         description: description,         image_url: image,         crawl_type: title ? \"text\" : \"image\",         code: '',         expiry: '',     };     dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
