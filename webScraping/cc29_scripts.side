      "comment": "",
      "command": "//executeScript",
      "target": "const elements = document.querySelectorAll(     'main>:nth-child(2)>:nth-child(1) a,div[id*=\"categorias\"] a, div[id*=\"grid\"] a' ); const dataArr = []; elements.forEach((a) => {     let url = a.href;     if (!url) {         url = a.querySelector(\"a\");         url = url ? url.href : \"\";     }     if (!url.startsWith(\"http\")) {         url = \"https://www.pccomponentes.com\" + url;     }     let title = a.querySelector(\"h3\");     if (!title) {         title = a.querySelector(\"span\");     }     title = title ? title.innerText : \"\";     if (title == \"\") {         title = a.querySelector(\"img\");         title = title ? title.title : \"\";     }     let description = a.querySelector(\"p\");     description = description ? description.innerText : \"\";     let image = a.querySelector(\"img\");     image = image ? image.srcset : \"\";     if (image == \"\") {         image = a.querySelector(\"img\");         image = image ? image.src : \"\";     }     if (!image.startsWith(\"http\") && image != \"\") {         image = \"https:\" + image;     }     if (!title && !image) {         return;     }     let crawl_type = \"\";     if (!title) {         crawl_type = \"image\";     } else {         crawl_type = \"text\";     }     let row = {         store: \"pccomponentes.com\",         url: url,         title: title,         description: description,         image_url: image,         crawl_type: crawl_type,         code: \"\",         expiry: \"\",     };     dataArr.push(row); }); const elements1 = document.querySelectorAll('div[id*=\"google_ads_iframe\"]'); elements1.forEach((a) => {     let url = \"https://www.pccomponentes.com\";     let title = a.querySelector('iframe[id*=\"google_ads_iframe\"]')?.contentDocument?.querySelector('img');     title = title ? title.alt : \"\";     let description = \"\";     let image = a.querySelector('iframe[id*=\"google_ads_iframe\"]')?.contentDocument?.querySelector('img');     image = image ? image.src : \"\";     let row = {         store: \"pccomponentes.com\",         url: url,         title: title,         description: description,         image_url: image,         crawl_type: image ? \"image\" : \"text\",         code: \"\",         expiry: \"\",     };     dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
      "value": "data"
    }, {
      "id": "eea051e9-bce5-418f-9dbb-02e5927426a3",
