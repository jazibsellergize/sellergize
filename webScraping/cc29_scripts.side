      "target": "const dataArr = []; const elements_text = document.querySelectorAll(   'button[data-ui-object *= \"price\"], div[class *= \"card-list-grid\"] > div' ); elements_text.forEach((a) => {   let title = a.querySelector('div[class *= \"name\"]'); if(!title){   title = a.querySelector('span'); }   title = title?.innerText; if(!title){   return; } let description = a.querySelector('div[class *= \"Pricing-discount\"]');  description = description?.innerText;    let url = a.href;   if(!url){     url = a.querySelector('a');     url = url ? url.href : \"https://quickbooks.intuit.com/pricing/#\"   }      if (url && !url.startsWith(\"https\")) {     url = \"https://quickbooks.intuit.com\" + url;   }     let row = {     store: \"quickbooks.intuit.com\",     url: url,     title: title,     description: description,     image_url: '',     crawl_type: \"text\",     code: '',     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
