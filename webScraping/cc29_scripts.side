      "target": "const elements = document.querySelectorAll(   'div.icons-container >  div:nth-child(3)' ); const dataArr = []; elements.forEach((a) => {   let url = a.link;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\")) {     url = \"https://www.vitaminshoppe.com\" + url;   }   let title = a.querySelector(\"h3\");   title = title ? title.innerText : \"\";   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if (!image.startsWith(\"http\") && image != \"\") {     image = \"https:\" + image;   }   if (!title && !image) {     return;   }   let row = {     store: \"vitaminshoppe.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: title ? \"text\" : \"image\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
