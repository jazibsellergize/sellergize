      "target": "const elements_image = document.querySelectorAll(     'div[class*=\"offer-\"] div[class*=\"card \"]' ); const dataArr = []; elements_image.forEach((a) => {     let url = a.querySelector(\"a\");     url = url ? url.href : \"https://www.pvrcinemas.com/offers\";     let image = a.querySelector(\"img\");     if (!image) {         return;     }     image = image.src;     let title = a.querySelector(\"span\");     title = title ? title.innerText : \"\";     let description = a.querySelector('div[class*=\"footer\"] span');     description = description ? description.innerText : \"\";     let row = {         store: \"pvrcinemas.com\",         url: url,         title: title,         description: description,         image_url: image,         crawl_type: \"image\",         code: \"\",         expiry: \"\",     };     dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
