      "target": "const elements = document.querySelectorAll(     'div[class=\"base-shadow\"], section[id=\"pizza\"] div[data-fetch-key=\"Banner:1\"], section[id=\"pizza\"] div[class=\"base-promotional-card__grid\"]>div'     );   const dataArr = [];   elements.forEach((a) => {     let url = a.link;     if(!url){       url = a.querySelector(\"a\");       url = url ? url.href : \"\";     }     if (!url.startsWith(\"http\")) {       url = \"https://www.dominos.co.uk/store/29137/london-victoria/menu\" + url;     }     let title = a.querySelector('h2');     title = title ? title.innerText : \"\";     if(title == \"\"){       title = a.querySelector('img');       title = title ? title.alt : \"\";     }     let description = a.querySelector('span[class*=\"text\"]');     description = description ? description.innerText : \"\";     let image = a.querySelector(\"source\");     image = image ? image.srcset : \"\";     image = image.substring(0, image.indexOf(\"?\"));     if(image == \"\"){       image = a.querySelector('img');       image = image ? image.src : \"\";     }     if (!image.startsWith(\"http\") && image != \"\") {       image = \"https:\" + image;     }     if (!title && !image) {       return;     }     let crawl_type = '';     if(!title){       crawl_type = 'image';     }else{       crawl_type = 'text';     }     let row = {       store: \"dominos.co.uk\",       url: url,       title: title,       description: description,       image_url: image,       crawl_type: crawl_type,       code: '',       expiry: '',     };     dataArr.push(row);   });   localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr));   return JSON.stringify(dataArr);",
