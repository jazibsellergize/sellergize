       store: \"atida.com\",         url: url,         title: title,         description: description,         image_url: image,         crawl_type: \"image\",         code: \"\",         expiry: \"\",     };     dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
