      "command": "executeScript",
      "target": "const elements = document.querySelectorAll(   'div[class *= \"swiper-slide\"],section[data-id *= \"cd9\"] div[class *= \"element-populated\"] ' ); const dataArr = []; elements.forEach((a) => {   let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.truevalue.com/\";   if (!url) {     url = a.href ? a.href : \"https://www.truevalue.com/\";   }   let title = a.querySelector(\"span\");   title = title ? title.innerText : \"\";   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if(!image){     image = a.querySelector(\"div[class *= 'carousel-image']\");     image = image ? image.style.backgroundImage.slice(5, -2) : \"\";   }   if (!title && !image) {     return;   }   let row = {     store: \"truevalue.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: image ? \"image\" : \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
