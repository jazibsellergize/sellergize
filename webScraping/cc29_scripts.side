      "target": "const elements = document.querySelectorAll( \"form[data-testid*='klaviyo-form'],div[class*='announcement-bar__wrap'], div[class='flickityt4s-slider'] ,div[class='flickityt4s-slider'] li, div[class*='t4s-shipping-list']>div:first-child\"); const dataArr = []; elements.forEach((a) => {   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\")) {     url = \"https://momcozy.com/\" + url;   }   let title = a.querySelector(\"div[id*='rich-text'], div[class*='shipping-title']\");    if (!title) {     title = a.querySelector(\"p, span\");   }   if (!title) {     title = a.querySelector(\"div\");   }   title = title ? title.innerText : \"\";   if (title == \"\") {     title = a.querySelector(\"img\");     title = title ? title.alt : \"\";   }   if (title == \"\") {     title = a.innerText;   }   let description = a.querySelector(\"p, span\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if (!image.startsWith(\"http\") && image != \"\") {     image = \"https:\" + image;   }   if (!title && !image) {     return;   }   let crawl_type = \"\";   if (!title) {     crawl_type = \"image\";   } else {     crawl_type = \"text\";   }   let row = {     store: \"momcozy.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: crawl_type,     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
