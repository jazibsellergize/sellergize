      "target": "const dataArr = [];  const elements_image = document.querySelectorAll(   '.email-campaign-wrapper' ); elements_image.forEach((a) => {   let url = a.querySelector(\"a\");   if (url == \"\") {     url = a;   }   url = url ? url.href : \"https://www.westelm.com/\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";    let title = a.querySelector(\"h2\");     if (!title) {         return;     }   title = title.innerText;    let description = a.querySelector(\"p\");     description = description ? description.innerText : \"\";   let row = {     store: \"westelm.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
