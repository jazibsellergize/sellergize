      "comment": "",
      "command": "//executeScript",
      "target": "  const elements_text = document.querySelectorAll(   'div[class*=\"text-uppercas\"] a,ul[class*=\"semibold\"] > li' ); const dataArr = []; elements_text.forEach((a) => {   let url = a.querySelector(\"a\");   if(!url){     url = a;   }   let title = a;   url = url ? url.href : \"https://www.clickelectrodomesticos.com/\";   title = title ? title.innerText : \"\";   if (!title) {     return;   }   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   let row = {     store: \"clickelectrodomesticos.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row);   console.log(row); });  const elements_image = document.querySelectorAll(   'section[class*=\"slider\"],ul[class*=\"categories-list\"] > li,div[class*=\"brand_slide\"]' ); elements_image.forEach((a) => {   let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.clickelectrodomesticos.com/\";   let image = a.querySelector(\"img\");   if (!image) {     return;   }   image = image.src;   let title = a.querySelector(\"h2\");   if (!title) {     title = a.querySelector(\"span\");   }   title = title ? title.innerText : \"\";   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let row = {     store: \"clickelectrodomesticos.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"image\",     code: \"See Image\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
