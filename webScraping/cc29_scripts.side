      "value": ""
    }, {
      "id": "6b03ff98-7838-4e68-8ca0-f9cfae01473b",
      "comment": "",
      "command": "//executeScript",
      "target": "const elements = document.querySelectorAll(   'div[class*=\" md:block\"], div[class=\"relative w-full h-full py-6 \"], div[class*=\"swiper-backface-hidden\"] div[class*=\"slide\"],div[class=\"bg-background-off\"]' ); const dataArr = []; elements.forEach((a) => {   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\")) {     url = \"https://www.pcdiga.com\" + url;   }   let title = a.querySelector('h4');   if (!title) {     title = a.querySelector('p');   }   if (!title) {     title = a.querySelector('a');   }   title = title ? title.innerText : \"\";   let description = a.querySelector('p');   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if(image.includes(\"data:image\")){     image = '';   }   if (!image.startsWith(\"http\") && image != \"\") {     image = \"https:\" + image;   }   if (!title && !image) {     return;   }   let crawl_type = '';   if (!title) {     crawl_type = 'image';   } else {     crawl_type = 'text';   }   let row = {     store: \"pcdiga.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: crawl_type,     code: '',     expiry: '',   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
      "value": "data"
    }, {
      "id": "ea51e0fe-9b2f-46ae-9d48-7fc77bd80734",
      "comment": "",
      "command": "//executeScript",
      "target": "return 'pcdiga-HP'",
      "targets": [],
      "value": "filename"
    }, {
      "id": "a61b2cff-3730-4f32-b7c4-79563fedf692",
      "comment": "",
      "command": "//runScript",
      "target": "var filename = ${filename}+\".json\"; var element = document.createElement(\"a\"); element.setAttribute(   \"href\",   \"data:text/plain;charset=utf-8,\" +     encodeURIComponent(localStorage.getItem(\"crawl_data\")) ); element.setAttribute(\"download\", filename); element.style.display = \"none\"; document.body.appendChild(element); element.click(); document.body.removeChild(element);",
      "targets": [],
      "value": ""
    }, {
      "id": "39f229eb-21d9-4699-b4fe-1e2bec17dd99",
      "comment": "",
      "command": "//executeAsyncScript",
      "target": "return fetch(   \"https://source.linkmydeals.com/selenium/getSeleniumData.php?file=\" +     ${filename},   {     method: \"POST\",     headers: { \"content-type\": \"application/json\" },     body: localStorage.getItem(\"crawl_data\"),   } ).then((res) => {   return res.text(); }).then((data) => {     return data; });",
      "targets": [],
      "value": ""
    }, {
