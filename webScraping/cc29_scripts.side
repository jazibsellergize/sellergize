      "comment": "",
      "command": "executeScript",
      "target": "const dataArr = []; const elements = document.querySelectorAll(   \"ul[class='splide__list']>li a ,.feature-benefit-cards, .image-container  \", ); elements.forEach((a) => {   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.katespade.com/\" + url;   }   let title = a.querySelector(\"h1, h2, a[class*='text-cta-underline']\");   if (!title) {     title = a.querySelector(\"div.promo-item, .at-text-block\");   }   if (!title) {     title = a.querySelector(\"p[data-qa*='pt_title']\");   }   title = title ? title.innerText : \"\";   if (title == \"\") {     title = a.querySelector(\"img\");     title = title ? title.alt : \"\";   }   if (title == \"\") {     title = a.innerText;   }   let description = a.querySelector(\"p,a \");   description = description ? description.innerText.trim() : \"\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   if (!image_src) {     image_src = a.querySelector(\"source\")?.getAttribute(\"srcset\") || \"\";   }   if (!image_src.startsWith(\"http\") && image_src != \"\") {     image_src = \"https:\" + image_src;   }   if (!title && !image) {     return;   }   let crawl_type = \"\";   if (!title) {     crawl_type = \"image\";   } else {     crawl_type = \"text\";   }   let code = a.querySelector(\"b\");   code = code ? code.innerText : \"\";   let row = {     store: \"katespade.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: crawl_type,     code: code,     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
