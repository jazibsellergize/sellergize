    }, {
      "id": "131b44a9-da0f-42b3-85e0-6e8f72a58276",
      "comment": "",
      "command": "executeScript",
      "target": "const dataArr = []; const elements_text = document.querySelectorAll(   \"div.container-cupons > div, div[data-testid='news-letter-content'] > div > a\" ); elements_text.forEach((a) => {   let url = a.querySelector(\"a\");   url = url ? url.href : \"\";   if (!url.startsWith(\"http\")) {     url = \"https://www.centauro.com.br/\" + url;   }   if (!url) {     url = \"https://www.centauro.com.br/sc/cupom-de-desconto-centauro\";   }   let title = a.querySelector(\"h1\");   title = title ? title.innerText : \"\";   if (title == \"\") {     title = a.querySelector(\"img\");     title = title ? title.alt : \"\";   }   if (title == \"\") {     title = a.innerText;   }   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if (!image.startsWith(\"http\") && image != \"\") {     image = \"https:\" + image;   }   if (!title && !image) {     return;   }   let code = a.querySelector(\"input.h1-titulo-bold\");   code = code ? code.value : \"\";   if (!code) {     code = a.querySelector(\"strong\");     code = code ? code.innerText : \"\";   }   let crawl_type = \"\";   if (!title) {     crawl_type = \"image\";   } else {     crawl_type = \"text\";   }   let row = {     store: \"centauro.com.br\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: crawl_type,     code: code,     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
      "value": "data"
    }, {
      "id": "263fd0f6-f601-4a49-ad59-533857c90f76",
      "comment": "",
      "command": "runScript",
      "target": "var filename = ${filename}+\".json\"; var element = document.createElement(\"a\"); element.setAttribute(   \"href\",   \"data:text/plain;charset=utf-8,\" +     encodeURIComponent(localStorage.getItem(\"crawl_data\")) ); element.setAttribute(\"download\", filename); element.style.display = \"none\"; document.body.appendChild(element); element.click(); document.body.removeChild(element);",
      "targets": [],
      "value": ""
    }, {
      "id": "c0fcae5f-09b7-4c64-8c9c-b0cf582aacfe",
      "comment": "",
      "command": "executeAsyncScript",
      "target": "return fetch(   \"https://source.linkmydeals.com/selenium/getSeleniumData.php?file=\" +     ${filename},   {     method: \"POST\",     headers: { \"content-type\": \"application/json\" },     body: localStorage.getItem(\"crawl_data\"),   } ).then((res) => {   return res.text(); }).then((data) => {     return data; });",
      "targets": [],
