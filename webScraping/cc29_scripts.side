      "id": "8f545e29-acb6-4674-a55d-1e8093dcb15a",
      "comment": "",
      "command": "executeScript",
      "target": "const dataArr = []; const list_elements = document.querySelectorAll(\"nav.ng-star-inserted ul>li\");  for (let i = 0; i < list_elements.length && i < 7; i++) {   let a = list_elements[i];   let title = a.querySelector(\"a\");   title = title ? title.innerText : \"\";   let description = \"\";   let image = \"\";   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.gamivo.com/\" + url;   }   if (!url) {     url = \"https://www.gamivo.com\";   }    let code = \"\";    let row = {     store: \"gamivo.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"text\",     code: code,     expiry: \"\",   };   dataArr.push(row); }  const elements_text = document.querySelectorAll(   \"div.gallery-item>div,  div.daily-smart>div>div, div[class*='home-banners-carousel--title'], div.newsletter\" );  elements_text.forEach((a) => {   let title = a.querySelector(\"div[class*='product__title']\");   if (!title) {     title = a.querySelector(\"span[class*='banner__title']\");   }   if (!title) {     title = a.querySelector(\"span[class*='newsletter__header']\");   }   if (!title) {     title = a.querySelector(\"h2, span\");   }   title = title ? title.innerText : \"\";   let description = a.querySelector(     \"div.show-all-btn>a,  span[class*='newsletter__subheader'], p\"   );   description = description ? description.innerText.trim() : \"\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.gamivo.com/\" + url;   }   if (!url) {     url = \"https://www.gamivo.com\";   }    let code = a.querySelector(\"p.coupon__code\");   code = code ? code.innerText : \"\";    let row = {     store: \"gamivo.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: \"text\",     code: code,     expiry: \"\",   };   dataArr.push(row); });  localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
