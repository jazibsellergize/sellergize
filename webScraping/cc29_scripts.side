    }, {
      "id": "8673bdef-4caa-486f-b9c9-1cbaf9277b60",
      "comment": "",
      "command": "//executeScript",
      "target": "return (document.querySelectorAll(     'div[aria-label=\"Voucher\"]' ).length > 0);",
      "targets": [],
