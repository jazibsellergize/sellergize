      "target": "const dataArr = []; const baseElements = document.querySelectorAll(   \"div[class*='sc-gYhhMS'], div.promoBar-message, #SinsayNewsletter>div\" );  const allLi = document.querySelectorAll(\"div[class*='Desktop-module__groups'] > nav:nth-child(2) ul > li\"); const lastFourLi = Array.from(allLi).slice(-4);  const elements_text = [...baseElements, ...lastFourLi]; elements_text.forEach((a) => {   let title = a.querySelector(\"h1\");   if(!title) {     title = a.querySelector(\"h3, a\");   }   if(!title) {     title = a.querySelector(\"p\");   }   if (!title) {     return;   }   title = title.innerText;    let description = a.querySelector(\"p:nth-child(2), p\");   description = description ? description.innerText : \"\";    let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";    let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.sinsay.com/pl/pl/\";    let row = {     store: \"sinsay.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };    dataArr.push(row); }); const elements_image = document.querySelectorAll(   \"div.owl-stage>div\" ); for (let i = 0; i < elements_image.length && i < 10 ; i++) {   let a = elements_image[i];    let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.sinsay.com/pl/pl/\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   if (!image_src) {     return;   }   let title = image.alt;   let row = {     store: \"sinsay.com\",     url: url,     title: title,     description: \"\",     image_url: image_src,     crawl_type: \"image\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }; localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
