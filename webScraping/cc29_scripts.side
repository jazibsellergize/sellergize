      "target": "const elements_image1 = document.querySelectorAll(   'div[class*=\"owl-item\"], div[class*=\"c-content-product-3\"] a, div[class=\"ng-star-inserted\"]' ); const dataArr = []; elements_image1.forEach((a) => {   let url = a.href;   if (!url) {       url = a.querySelector(\"a\");       url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != '') {       url = \"https://armazensronfe.pt\" + url;   }else if(url == ''){       url = \"https://armazensronfe.pt/pt\";   }   let title = a.querySelector(\"span\");   title = title ? title.innerText : \"\";   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector('img[class*=\"lazyloaded\"]');   if (!image) {     return;   }   image = image.src;   if (!image.startsWith(\"http\")) {     image = \"https:\" + image;   }   let crawl_type = \"\";   if (!title) {       crawl_type = \"image\";   } else {       crawl_type = \"text\";   }   let row = {     store: \"armazensronfe.pt\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: crawl_type,     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
