      "id": "fe5d74f9-7c3f-43ad-9a0f-0d23608e2a6d",
      "comment": "",
      "command": "//executeScript",
      "target": "return document.querySelectorAll(   'div[class*=\" md:block\"], div[class=\"relative w-full h-full py-6 \"], div[class*=\"swiper-backface-hidden\"] div[class*=\"slide\"],div[class=\"bg-background-off\"]' ).length > 0;",
