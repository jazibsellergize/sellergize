      "comment": "",
      "command": "executeScript",
      "target": "const elements_text = document.querySelectorAll(   '.bb_container > div:nth-of-type(2), .newscomponent-slider-container div[class = \"slick-slide\"], div[class *= \"header-banner-thin\"], .content-slider, div[class *= \"banner-slim-4\"], .bb_items' ); const dataArr = []; elements_text.forEach((a) => {   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.usereserva.com/\" + url;   } else if (url == \"\") {     url = \"https://www.usereserva.com/\";   }   let title = a.querySelector('div[class *= \"title\"]');   if (!title) {     title = a;   }   title = title ? title.innerText : \"\";   if (!title) {     title = a.querySelector(\" img\");     title = title ? title.alt : \"\";   }   let description = a.querySelector(' div[class *= \"group__text\"]');   description = description ? description.innerText : \"\";   let image = a.querySelector(\" source\");   image = image ? image.srcset : \"\";   if (!image) {     image = a.querySelector(\" img, video\");     image = image ? image.src : \"\";   }   if (!image.startsWith(\"http\") && image != \"\") {     image = \"https:\" + image;   }   if (!title && !image) {     return;   }   let row = {     store: \"usereserva.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
