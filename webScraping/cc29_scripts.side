      "target": "const dataArr = []; const elements_text = document.querySelectorAll(     '.pricing-model > div, .yearly-label' ); elements_text.forEach((a) => {   let title = a.querySelector('h2'); if(!title){   title = a; }       title = title?.innerText;    let desciption = a.querySelector('.price-span');    desciption = desciption ? desciption.innerText : \"\";    let url = a.href;   if(!url){     url = a.querySelector('a');     url = url ? url.href : \"https://vizard.ai/pricing\";   }      if (url && !url.startsWith(\"https\")) {     url = \"https://vizard.ai\"  + url;   }    let row = {     store: \"vizard.ai\",     url: url,     title: title,     description: desciption,     image_url: '',     crawl_type: title ? \"text\" : \"image\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
