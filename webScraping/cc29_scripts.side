      "comment": "",
      "command": "executeScript",
      "target": "const elements_text = document.querySelectorAll(   \"div[class *= 'products_card'], div[class *= 'owl-item']\" ); const dataArr = []; elements_text.forEach((a) => {   let url = a.querySelector(\"a\");  url = url ? url.href : \"https://destinia.com/\";   if (!url) {     url = a.href;   }   let title = a.querySelector(\"h3\");   if (!title) {     title = a;   }   if (!title) {     return;   }   title = title.innerText;   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if (image.includes(\"svg\")) {     image = \"\";   }    let row = {     store: \"destinia.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
      "value": "data"
    }, {
