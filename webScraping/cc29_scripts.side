      "command": "executeScript",
      "target": "const dataArr = []; const elements_text = document.querySelectorAll('article[class *= \"css\"]'); elements_text.forEach((a) => {   let title = a.querySelector('div[class *= \"css-lkduem\"]:first-of-type');   title = title ? title.innerText : \"\";   let description = a.querySelector(     'strong[class *= \"css-1e\"], strong[class *= \"css-1b\"]'   );   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.datacamp.com/\" + url;   }   if (!url) {     url = \"https://www.datacamp.com/pricing?tab=workspace&period=yearly\";   }   let row = {     store: \"datacamp.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
