      "target": "const dataArr = []; const elements_text = document.querySelectorAll(   '.header-promotion  ,.wts-banner__container a , .hp__more--tile, section[id = \"homepage_recs_02\"] li' ); elements_text.forEach((a) => {   let title = a.querySelector(\"a\");   if (!title) {     title = a.querySelector(\"span\");   }   if (!title) {     title = a.querySelector(\"p\");   }   if (!title) {     return;   }   title = title.innerText;   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.sallybeauty.com\";   let row = {     store: \"sallybeauty.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); const elements_image = document.querySelectorAll(   'section[id = \"hp_promos\"] .slick-slide' ); elements_image.forEach((a) => {   let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.sallybeauty.com\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   if (!image_src) {     return;   }   let title = image.alt;   let row = {     store: \"sallybeauty.com\",     url: url,     title: title,     description: \"\",     image_url: image_src,     crawl_type: \"image\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
