      "command": "//executeScript",
      "target": "const elements = document.querySelectorAll(   '.header-promo,div[class*=\"promo-banner\"],.top-parts-item,#maker ul li,#brand ul li' ); const dataArr = []; elements.forEach((a) => {   let url = a.querySelector(\"a\");   if(url) {     url = url.href;   } else {     url = a.querySelector(\"span[data-link]\");     url = url ? url.getAttribute('data-link') : \"https://www.autodoc.de/\";   }   if(!url.startsWith('http')) {     url = \"https://www.autodoc.de/\"+ url;   }       let title = a.querySelector(\".header-promo__label-text\");   title = title ? title.innerText : \"\";   if (!title) {     title = a.querySelector(\"img\");     title = title ? title.alt : \"\";   }   if(!title) {     title = a.querySelector(\".top-parts-item__name\");     title = title ? title.innerText : \"\";   }     let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if (!title && !image) {     return;   }   let row = {     store: \"autodoc.de\",     url: url,     title: title,     description: \"\",     image_url: image,     crawl_type: image ? \"image\" : \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
      "value": "data"
    }, {
