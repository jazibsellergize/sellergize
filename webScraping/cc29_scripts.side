      "target": "const dataArr = []; const elements_text = document.querySelectorAll(   \"div[data-testid='grid-item']>div\" ); elements_text.forEach((a) => {   let title = a.querySelector(\"h1\");   title = title ? title.innerText : \"\";   let description = a.querySelector(\"button[class*='connect-link']\");   description = description ? description.innerText.trim() : \"\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.bstn.com/eu_de/\" + url;   }   if (!url) {     url = \"https://www.bstn.com/eu_de/studentbeans\";   }   let row = {     store: \"bstn.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
