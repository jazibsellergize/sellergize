      "target": " const elements_text = document.querySelectorAll(   'div[class=\"pkw-features\"] li,div[class=\"ersatz-tab__top\"]' ); const dataArr = []; elements_text.forEach((a) => {   let url = a.querySelector(\"a\");   let title = a.querySelector(\"a\");   url = url ? url.href : \"https://www.autoparti.it/\";   if (!title) {     title = a;   }   if (!title) {     return;   }   title = title.innerText;   let description = a.querySelector(\"ul\");   description = description ? description.innerText : \"\";   if(description){     description = description.replaceAll(/\\u000A/g, \"\");   }   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   let row = {     store: \"autoparti.it\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row);   console.log(row); }); const elements_image = document.querySelectorAll(   'div[class=\"index-selection\"],div[id=\"content\"] div[class*=\"top-cats__item\"]' ); elements_image.forEach((a) => { let url = a.querySelector(\"a\"); url = url ? url.href : \"https://www.autoparti.it/\"; let image = a.querySelector(\"img\"); if (!image) {   return; } image = image.src; let title = a.querySelector(\"img\"); title = title ? title.alt : \"\"; let description = a.querySelector(\"p\"); description = description ? description.innerText : \"\"; let row = {   store: \"autoparti.it\",   url: url,   title: title,   description: description,   image_url: image,   crawl_type: \"image\",   code: \"See Image\",   expiry: \"\", }; dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
