      "target": "const dataArr = []; const elements_annually = document.querySelectorAll(   \"div[class*='header_mainTopBar'] ul, div[class*='heroImage_buttons']>a, div[class*='tile_buttons']>a, div[class*='footer_footerSection']>li\" ); elements_annually.forEach((a) => {   let title = a.querySelector(\"h2, strong\");   if (!title) {     title = a.querySelector(\"li\");   }   if (!title) {     title = a.querySelector(\"a\");   }   title = title ? title.innerText : a.innerText.trim();   let description = a.querySelector(\"p\");   description = description ? description.innerText.trim() : \"\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.hellyhansen.com/en_us\" + url;   }    let row = {     store: \"hellyhansen.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
