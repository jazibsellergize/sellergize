      "target": "",
      "targets": [],
      "value": ""
    }, {
      "id": "b69f5583-5bf1-44af-9943-24c50df34b4b",
      "comment": "",
      "command": "//executeScript",
      "target": "return document.querySelectorAll(     'div[class=\"heroBanner\"], div[class=\"categories-container-card-list\"]>a, div[class=\"promo\"]'     ).length > 0;",
      "targets": [],
      "value": "check"
    }, {
      "id": "ca5ebf5f-f332-4fc8-be25-4968ee359d1f",
      "comment": "",
      "command": "//end",
      "target": "",
      "targets": [],
      "value": ""
    }, {
      "id": "4ded81ab-b7f9-4bce-8fa0-e1c19817d30f",
      "comment": "",
      "command": "//executeScript",
      "target": "const elements = document.querySelectorAll(     'div[class=\"heroBanner\"], div[class=\"categories-container-card-list\"]>a, div[class=\"promo\"]' ); const dataArr = []; elements.forEach((a) => {     let url = a.href;     if (!url) {         url = a.querySelector(\"a\");         url = url ? url.href : \"\";     }     if (!url.startsWith(\"http\")) {         url = \"https://www.7now.com\" + url;     }     let title = a.querySelector('span');     if(!title){         title = a.querySelector('a');     }     title = title ?  title.innerText : \"\";     if(title == ''){         title = a.querySelector('img');         title = title ?  title.alt : \"\";     }      if(title == ''){         title = a.innerText;     }       let description = a.querySelector('p');     description = description ? description.innerText : \"\";     let image = a.querySelector('img');     image = image ? image.src : \"\";     if(image.includes('data:image')){         image == '';     }      if (!title && !image) {         return;     }     if (!image.startsWith(\"http\") && image != \"\") {         image = \"https:\" + image;     }           let crawl_type = '';     if (!title) {         crawl_type = 'image';     } else {         crawl_type = 'text';     }     let row = {         store: \"7now.com\",         url: url,         title: title,         description: description,         image_url: image,         crawl_type: crawl_type,         code: '',         expiry: '',     };     dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
      "value": "data"
    }, {
      "id": "8057c0eb-4655-4cb2-be11-afc73ca129d0",
      "comment": "",
      "command": "//executeScript",
      "target": "return '7now-HP'",
      "targets": [],
      "value": "filename"
    }, {
      "id": "c0613747-eded-4206-8d15-38b5067da636",
      "comment": "",
      "command": "//runScript",
      "target": "var filename = ${filename}+\".json\"; var element = document.createElement(\"a\"); element.setAttribute(   \"href\",   \"data:text/plain;charset=utf-8,\" +     encodeURIComponent(localStorage.getItem(\"crawl_data\")) ); element.setAttribute(\"download\", filename); element.style.display = \"none\"; document.body.appendChild(element); element.click(); document.body.removeChild(element);",
      "targets": [],
      "value": ""
    }, {
      "id": "23f12712-2739-46d6-8bec-4cea6ba642ec",
      "comment": "",
      "command": "//executeAsyncScript",
      "target": "return fetch(   \"https://source.linkmydeals.com/selenium/getSeleniumData.php?file=\" +     ${filename},   {     method: \"POST\",     headers: { \"content-type\": \"application/json\" },     body: localStorage.getItem(\"crawl_data\"),   } ).then((res) => {   return res.text(); }).then((data) => {     return data; });",
      "targets": [],
      "value": ""
    }, {
      "id": "f9ec3f12-9446-49ea-8659-a72c8055c85e",
      "comment": "",
      "command": "//pause",
      "target": "3000",
      "targets": [],
      "value": ""
    }]
