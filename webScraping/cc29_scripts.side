      "target": "const dataArr = []; const elements_text = document.querySelectorAll(   '.top_hero, .half_width, .carousel-item, .special_promo , .text_header, .special_promo  .content-btn-container a  ' ); elements_text.forEach((a) => {   let title = a.querySelector(' .text_heading');     if(!title){     title = a;   }   title = title?.innerText;    if(!title) {     title = a.querySelector('img');     title = title ? title.alt : \"\";   }   let description = a.querySelector('.text_paragraph');    description = description?.innerText;   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"https://www.calvinklein.ca/en\";   }   if (url && !url.startsWith(\"https\")) {     url = \"https://www.calvinklein.ca\" + url;   }    let image = a.querySelector(\"source\");   image = image ? image.srcset : \"\";   if(!image) {     image = a.querySelector(\"img\");     image = image ? image.src : \"\";   }    if( image && !image.startsWith(\"https\")) {     image = \"https:\" + image;   }    if(!title && !image) {     return;   }       let row = {     store: \"calvinklein.ca\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: title ? \"text\" : \"image\",     code: '',     expiry: \"\",   };   dataArr.push(row); });    localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
