      "command": "executeScript",
      "target": "const dataArr = []; const elements_text = document.querySelectorAll(   \".featured-carousel, .subscribe-modal__wrapper, #main > div:nth-child(2), div[id*='email-sign-up_desktop'] ,.marketing-tiles__col ,.footer-item--subscription__inner-wrap, .dashboard__content \" ); elements_text.forEach((a) => {   let title = a.querySelector(\"h3, h2\");   if (!title) {     title = a.querySelector(\"p[class*='h2']\");   }   if (!title) {     title = a.querySelector(\".footer-item__link.text--semibold\");   }   if (!title) {     title = a.querySelector(\"span, a\");   }   if (!title) {     return;   }   title = title.innerText;   let description = a.querySelector(\"p[class*='type--micro']\");   if (!description) {     description = a.querySelector(\"footer-item__copy, span\");   }   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.converse.com/us\";   let row = {     store: \"converse.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); const elements_slider = document.querySelectorAll(\".slick-track > div\"); for (let i = 0; i < elements_slider.length && i < 4; i++) {   let a = elements_slider[i];   let title = a;   title = title ? title.innerText : \"\";   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.converse.com/us\";   let row = {     store: \"converse.com\",     url: url,     title: title,     description: description,     image_url: image_src,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); } let shadow_text = document.querySelector(\"klarna-placement\").shadowRoot; const elements = shadow_text.querySelectorAll(   \"div[data-testid*='top-strip-promotion']\" ); elements.forEach((a) => {   let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.converse.com/us\";   if (!url) {     url = \"https://www.converse.com/us\";   }   let title = a.querySelector(\"p\");   title = title ? title.innerText : \"\";   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   let image_src = image ? image.src : \"\";   if (!title && !image) {     return;   }   let row = {     store: \"converse.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: title ? \"text\" : \"image\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
