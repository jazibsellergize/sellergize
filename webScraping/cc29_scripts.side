      "target": "const elements_text = document.querySelectorAll(   'ul[class *= \"deals\"] li, section[class *= \"social-card \"]' ); const dataArr = []; elements_text.forEach((a) => {   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.macys.com\" + url;   }   let title = a.querySelector(\".white.margin-bottom-xs, h6\");   if (!title) {     title = a;   }   if (!title) {     return;   }   title = title.innerText;   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   let row = {     store: \"macys.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); const elements_image = document.querySelectorAll(   ' .slideshow_cell' ); elements_image.forEach((a) => {   let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.macys.com\";   let image = a.querySelector(\"img\");   let image_url = image ? image.getAttribute(\"data-src\") : \"\";   if (image_url == \"\") {     image_url = image ? image.getAttribute(\"srcset\") : \"\";   }   if (image_url == \"\") {     image_url = image ? image.getAttribute(\"src\") : \"\";   }   if (image_url == \"\") {     return;   }   let title = a.querySelector(\"p\");   title = title ? title.innerText : '';    let description = a;   description = description?.innerText;   let row = {     store: \"macys.com\",     url: url,     title: title,     description: description,     image_url: image_url,     crawl_type: \"image\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
