      "comment": "",
      "command": "//executeScript",
      "target": "const dataArr = []; const elements_image = document.querySelectorAll(   \".BannerSlide_contentContainer__V9SBp\" ); elements_image.forEach((a) => {   let url = a.querySelector(\"a\");   url = url ? url.href : \"https://www.noon.com/saudi-ar/ramadan-sale-offers-saudi/\";   let image = a.querySelector(\"img\");   if (!image) {     return;   }   image = image.src;   let title = a.querySelector(\"h2\");   if (!title) {     title = a.querySelector(\"img\");     title = title.alt;   } else {     title = title ? title.innerText : \"\";   }   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let row = {     store: \"noon.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"image\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
