    }, {
      "id": "5e7b2cd1-d784-4338-95da-fb0b26e8a25e",
      "comment": "",
      "command": "//end",
      "target": "",
      "targets": [],
      "value": ""
    }, {
      "id": "90b900ec-2e92-422f-aee2-3cb38382f9dd",
      "comment": "",
      "command": "//executeScript",
      "target": "const elements = document.querySelectorAll(     'div[aria-label=\"Voucher\"]' ); const dataArr = []; elements.forEach((a) => {     let url = a.link;     if (!url) {         url = a.querySelector(\"a\");         url = url ? url.href : \"\";     }     if (!url.startsWith(\"http\")) {         url = \"https://shopee.co.id\" + url;     }     let title = a.querySelector('div[role=\"presentation\"]');     title = title ? title.innerText : \"\";     let description = '';     let image = a.querySelector(\"img\");     image = image ? image.src : \"\";     if (!image.startsWith(\"http\") && image != \"\") {         image = \"https:\" + image;     }     if (!title && !image) {         return;     }     let crawl_type = '';     if (!title) {         crawl_type = 'image';     } else {         crawl_type = 'text';     }     let row = {         store: \"shopee.co.id\",         url: url,         title: title,         description: description,         image_url: image,         crawl_type: crawl_type,         code: '',         expiry: '',     };     dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
      "targets": [],
      "value": "data"
    }, {
      "id": "53305d58-952c-4774-b781-296036985966",
      "comment": "",
      "command": "//executeScript",
      "target": "return 'shopeeID-Coupon'",
      "targets": [],
      "value": "filename"
    }, {
      "id": "fada1fb7-ba27-40d0-8b8c-11703f384162",
      "comment": "",
      "command": "//runScript",
      "target": "var filename = ${filename}+\".json\"; var element = document.createElement(\"a\"); element.setAttribute(   \"href\",   \"data:text/plain;charset=utf-8,\" +     encodeURIComponent(localStorage.getItem(\"crawl_data\")) ); element.setAttribute(\"download\", filename); element.style.display = \"none\"; document.body.appendChild(element); element.click(); document.body.removeChild(element);",
      "targets": [],
      "value": ""
    }, {
      "id": "13536455-9ba4-495a-b80f-44e32c00c42a",
      "comment": "",
      "command": "//executeAsyncScript",
      "target": "return fetch(   \"https://source.linkmydeals.com/selenium/getSeleniumData.php?file=\" +     ${filename},   {     method: \"POST\",     headers: { \"content-type\": \"application/json\" },     body: localStorage.getItem(\"crawl_data\"),   } ).then((res) => {   return res.text(); }).then((data) => {     return data; });",
      "targets": [],
      "value": ""
    }, {
      "id": "a3df2aa0-f874-4394-bf8c-b110728518d8",
      "comment": "",
      "command": "//pause",
      "target": "3000",
      "targets": [],
      "value": ""
    }]
