      "target": "const elements = document.querySelectorAll(   'ul[class=\"l-highlights-container\"]>li, ul[class=\"o-nav__list\"]>li, section[data-merch-name] li[id],section[data-cerberus=\"SECTION_digitalFlyer\"],section[id*=\"component-f\"] li' ); const dataArr = []; elements.forEach((a) => {   let url = a.href;   if (!url) {     url = a.querySelector(\"a\");     url = url ? url.href : \"\";   }   if (!url.startsWith(\"http\") && url != \"\") {     url = \"https://www.leroymerlin.es\" + url;   } else if (url == \"\") {     url = \"https://www.leroymerlin.es/\";   }   let title = a.querySelector(\"h2\");   if (!title) {     title = a.querySelector(\"a\");   }   title = title ? title.innerText : \"\";   if (title) {     title = title.replaceAll(/\\u000A/g, \" \");     title = title.trim();   }   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if (!title && !image) {     return;   }   let row = {     store: \"leroymerlin.es\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: image ? \"image\" : \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); }); localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
