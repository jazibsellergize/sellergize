      "target": "const dataArr = [];  const elements_text = document.querySelectorAll(   'div[class=\"opcom-html\"],div[class=\"category-item-header\"]' );  elements_text.forEach((a) => {   let url = a.querySelector(\"a\");   let title = a.querySelector(\"span[class='hidden-xs']\");   if (!title) {     title = a.querySelector(\"h2\");   }   url = url ? url.href : \"https://www.oscaro.com/\";   if (!title) {     return;   }   title = title.innerText;   let description = a.querySelector(\"p\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   let row = {     store: \"oscaro.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); });  const elements_image1 = document.querySelectorAll(\".carousel-brand li\");  elements_image1.forEach((a) => {   let url = a.querySelector(\"a\");    url = url ? url.href : \"https://www.oscaro.com/\";    let image = a.querySelector(\"img\");   if (!image) {     return;   }   image_src = image.src;    let title = image.alt;    let row = {     store: \"oscaro.com\",     url: url,     title: title,     description: \"\",     image_url: image_src,     crawl_type: \"image\",     code: \"See Image\",     expiry: \"\",   };   dataArr.push(row); });  const elements_image2 = JSON.parse(document.getElementById(\"opcoms\").innerHTML); const dom = elements_image2[4][4][1]; for(let i=0; i<dom.length; i++) {   let image = dom[i][6];   if(!image) {     continue;   }   let title = dom[i][40] ? dom[i][40] : dom[i][26];   let url =  dom[i][36] ? dom[i][36] : \"https://www.oscaro.com/\";   let row = {     store: \"oscaro.com\",     url: url,     title: title,     description: \"\",     image_url: image,     crawl_type: \"image\",     code: \"See Image\",     expiry: \"\",   };   dataArr.push(row); }   localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr));  return JSON.stringify(dataArr);",
