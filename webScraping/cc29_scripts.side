      "target": "const elements_text = document.querySelectorAll(   '#ship-banner a , .prod_priceBlock' ); const dataArr = []; elements_text.forEach((a) => {   let url = a.querySelector(\"a\");   if (!url) {     url = a;   }   let title = a.querySelector(\"span\");   if (!title) {     title = a;   }   url = url ? url.href : \"https://www.kohls.com/catalog.jsp?CN=CouponEligible:Eligible\";   if (!title) {     return;   }   title = title.innerText;   let description = a.querySelector(\"p span\");   description = description ? description.innerText : \"\";   let image = a.querySelector(\"img\");   image = image ? image.src : \"\";   if (image.includes(\"svg\")) {     image = \"\";   }   let code = a.querySelector(\".yourprice-promocode\");   code = code ? code.innerText : \"\";   let row = {     store: \"kohls.com\",     url: url,     title: title,     description: description,     image_url: image,     crawl_type: \"text\",     code: \"\",     expiry: \"\",   };   dataArr.push(row); });  localStorage.setItem(\"crawl_data\", JSON.stringify(dataArr)); return JSON.stringify(dataArr);",
