[
    {
        "command": "storeValue",
        "value": "https://www.floweraura.com/my-orders",
        "result": "ordersLinksUrl"
    },
    {
        "command": "open",
        "value": "${ordersLinksUrl}"
    },
    {
        "command": "getCookieItem",
        "key": "_fa_uuid",
        "result": "customerId"
    },
    {
        "command": "initiateArray",
        "result": "dataArray"
    },
    {
        "command": "selectorLength",
        "selector": ".reviewOrderHeader",
        "result": "orderCount"
    },
    {
        "command": "storeValue",
        "value": "0",
        "result": "i"
    },
    {
        "command": "while",
        "condition": {
            "left": "${i}",
            "operator": "<",
            "right": "${orderCount}"
        },
        "loopActions": [
            {
                "command": "store",
                "type": "innerText",
                "selector": ".order-status",
                "result": "deliveryStatus"
            },
            {
                "command": "click",
                "selector": ".review-invoice div > div:first-child, .invoiceTitle"
            },
            {
                "command": "selectorLength",
                "selector": "#invoiceDiv .p-4",
                "result": "productLinksCount"
            },
            {
                "command": "storeValue",
                "value": "0",
                "result": "j"
            },
            {
                "command": "while",
                "condition": {
                    "left": "${j}",
                    "operator": "<",
                    "right": "${productLinksCount}"
                },
                "loopActions": [
                    {
                        "command": "store",
                        "type": "element",
                        "selector": "#invoiceDiv .p-4",
                        "index": "${j}",
                        "result": "prodElement"
                    },
                    {
                        "command": "store",
                        "type": "innerText",
                        "selector": "span.font-semibold.text-black",
                        "result": "orderId",
                        "index": "${prodElement}"
                    },
                    {
                        "command": "store",
                        "type": "innerText",
                        "selector": ".timeline .text-xs:last-child",
                        "result": "orderDate",
                        "index": "${prodElement}"
                    },
                    {
                        "command": "store",
                        "type": "attribute",
                        "attribute": "src",
                        "selector": ".invoiceInfo img",
                        "element": "${prodElement}",
                        "result": "image"
                    },
                    {
                        "command": "store",
                        "type": "innerText",
                        "selector": ".reviewTitle a",
                        "element": "${prodElement}",
                        "result": "productTitle"
                    },
                    {
                        "command": "store",
                        "selector": ".css-8sazvn p:last-child",
                        "type": "innerText",
                        "result": "elementQuantity"
                    },
                    {
                        "command": "callFunction",
                        "action": "extractSubstring",
                        "parameters": {
                            "fullString": "${elementQuantity}",
                            "stringAfter": ":",
                            "stringBefore": ""
                        },
                        "result": "quantity"
                    },
                    {
                        "command": "store",
                        "type": "innerText",
                        "selector": ".css-8sazvn p:last-child",
                        "element": "${prodElement}",
                        "result": "purchasePrice"
                    },
                    {
                        "command": "store",
                        "type": "attribute",
                        "attribute": "href",
                        "selector": ".invoiceInfo a",
                        "element": "${prodElement}",
                        "result": "productLink"
                    },
                    {
                        "command": "pushToArray",
                        "array": "dataArray",
                        "value": {
                            "orderId": "${orderId}",
                            "orderDate": "${orderDate}",
                            "deliveryStatus": "${deliveryStatus}",
                            "deliveryDate": "${deliveryDate}",
                            "productTitle": "${productTitle}",
                            "productLink": "${productLink}",
                            "purchasePrice": "${purchasePrice}",
                            "currentPrice": "",
                            "quantity": "${quantity}",
                            "image": "${image}",
                            "returnDate": "",
                            "warranty": ""
                        },
                        "result": "dataArray"
                    },
                    {
                        "command": "increment",
                        "selector": "${j}",
                        "result": "j"
                    }
                ]
            },
            {
                "command": "open",
                "value": "${ordersLinksUrl}"
            },
            {
                "command": "waitForElementVisible",
                "selector": ".order-detail-btn-revamp"
            },
            {
                "command": "increment",
                "selector": "${i}",
                "result": "i"
            }
        ]
    }
]